		"@velocity-exchange/sdk": "0.13.0",
		"copyfiles": "2.4.1",
		"encoding": "0.1.13",
		"lokijs": "1.5.12",
		"oxlint": "1.77.0",
		"pino-pretty": "10.2.3",
		"react": "19.0.3",
		"react-dom": "19.2.8",
		"typescript": "5.1.6"
	},
	"peerDependencies": {
		"@solana/spl-token": "0.4.15",
		"@solana/web3.js": "1.98.4",
		"react": "19.0.3",
		"react-dom": "19.2.8"
	},
	"dependencies": {
		"@drift/common": "npm:@velocity-exchange/common@0.4.1",
