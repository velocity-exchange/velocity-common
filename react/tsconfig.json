{
	"compilerOptions": {
		/* Visit https://aka.ms/tsconfig to read more about this file */

		"jsx": "react-jsx",
		"module": "ES2022",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"sourceMap": true,
		"rootDir": "./src",
		"outDir": "lib",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"paths": {
			"@velocity-exchange/sdk": ["./node_modules/@velocity-exchange/sdk"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "tests"]
}
