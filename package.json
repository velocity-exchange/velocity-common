	"devDependencies": {
		"@commitlint/cli": "19.6.1",
		"@commitlint/config-conventional": "19.6.0",
		"husky": "8.0.3",
		"oxfmt": "0.60.0",
		"oxlint": "1.75.0",
		"typescript": "5.1.6"
	},
	"scripts": {
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"prepare": "husky install",
		"format": "oxfmt --check './**/*.{ts,tsx}'",
		"format:fix": "oxfmt --write './**/*.{ts,tsx}'",
		"typecheck": "tsc --project common-ts --noEmit"
	},
	"dependencies": {
		"@types/big.js": "7.0.0",
		"posthog-js": "1.72.1"
	},
	"version": "0.0.1"
}
