{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": true,
	"trailingComma": "es5",
	"singleQuote": true,
	"printWidth": 80,
	"tabWidth": 2,
	"useTabs": true,
	"bracketSameLine": false,
	"sortPackageJson": false,
	"ignorePatterns": ["**/node_modules/**", "**/lib/**", "**/dist/**", "protocol"]
}
