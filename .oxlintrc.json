{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"node": true
	},
	"ignorePatterns": ["**/lib", "**/dist", "**/node_modules", "protocol", "icons"],
	"rules": {
		"typescript/triple-slash-reference": "off",
		"typescript/explicit-function-return-type": "off",
		"typescript/explicit-module-boundary-types": "off",
		"typescript/ban-ts-comment": "off",
		"typescript/no-explicit-any": "off",
		"typescript/no-var-requires": "off",
		"typescript/no-empty-function": "off",
		"no-unexpected-multiline": "off",
		"typescript/no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrors": "none"
			}
		],
		"no-unused-expressions": [
			"error",
			{
				"allowShortCircuit": true,
				"allowTernary": true,
				"allowTaggedTemplates": true
			}
		],
		"no-restricted-imports": [
			"error",
			{
				"patterns": [
					{
						"group": ["bn.js"],
						"message": "Import BN from @velocity-exchange/sdk instead"
					}
				]
			}
		]
	},
	"overrides": [
		{
			// format/core is import-free by rule so it can ship standalone or feed
			// a Rust port. Only sibling files inside the folder may be imported.
			"files": ["common-ts/src/format/core/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": ["**", "!./*"],
								"message": "format/core must have zero imports outside its own folder"
							}
						]
					}
				]
			}
		},
		{
			"files": ["**/tests/**"],
			"rules": {
				// chai assertions (`expect(x).to.be.true`) are bare member expressions
				"no-unused-expressions": "off"
			}
		}
	]
}
